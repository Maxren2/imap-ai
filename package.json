{
  "name": "imap-ai",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "imap-test": "npm run imap-test -w @imap-ai/core",
    "sync": "npm run sync -w @imap-ai/core",
    "watch": "npm run watch -w @imap-ai/core",
    "smtp-test": "npm run smtp-test -w @imap-ai/core",
    "backfill": "npm run backfill -w @imap-ai/core",
    "rules:run": "npm run rules:run -w @imap-ai/core",
    "rules:seed-example": "npm run rules:seed-example -w @imap-ai/core",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run db:migrate -w @imap-ai/core",
    "typecheck": "npm run typecheck -w @imap-ai/core && npm run typecheck -w @imap-ai/web",
    "dev": "npm run dev -w @imap-ai/web",
    "postinstall": "npm run generate -w @imap-ai/core"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
