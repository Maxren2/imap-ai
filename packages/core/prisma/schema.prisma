generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String    @id @default(cuid())
  email     String    @unique
  provider  String
  createdAt DateTime  @default(now())
  mailboxes Mailbox[]
  rules     Rule[]
  senderStatuses SenderStatus[]
  chat      Chat?
}

// Single persistent chat thread per account for v1 -- no multi-thread
// history/rename/delete yet (inbox-zero has that; deferred here for scope).
model Chat {
  id        String        @id @default(cuid())
  accountId String        @unique
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system"
  // AI SDK UIMessage `parts` array (text/tool-call/tool-result parts),
  // stored as-is rather than flattened to a plain string -- that's what
  // the frontend needs back to re-render tool cards on reload.
  parts     Json
  createdAt DateTime @default(now())

  @@index([chatId])
}

model Mailbox {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  uidValidity BigInt
  lastSeenUid Int       @default(0)
  // Marks the sync-window boundary from a date-bounded first sync (see
  // SYNC_BACKFILL_DAYS): everything with uid <= this value has NOT been
  // synced yet. Null once there's nothing left to backfill.
  backfillBeforeUid Int?
  fullyBackfilled   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  messages    Message[]

  @@unique([accountId, name])
}

model Message {
  id             String      @id @default(cuid())
  mailboxId      String
  mailbox        Mailbox     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  uid            Int
  gmailThreadId  String?
  gmailMessageId String?
  subject        String?
  fromAddress    String?
  fromName       String?
  // Only meaningfully populated for messages we sent (the IMAP envelope's
  // "to" address) -- used by the No-Reply feature to show who a sent
  // message went to, since `fromAddress` on a sent message is our own
  // address, not the recipient's. Not backfilled for existing sent mail by
  // a normal incremental sync (which only fetches UIDs newer than the last
  // seen one) -- see `npm run backfill-to-address` for that.
  toAddress      String?
  toName         String?
  date           DateTime
  flags          String[]
  labels         String[]
  // Tracked explicitly rather than derived from `labels` -- Gmail's
  // X-GM-LABELS response omits "\Inbox" when a message is fetched from
  // within the INBOX mailbox itself (confirmed live: only present when
  // viewed from a *different* folder), so the label array can't be used
  // to tell whether a synced-from-INBOX message is still there. Defaults
  // true on sync (it came from INBOX); set false by our own archive
  // actions. Doesn't detect an archive done outside this app (e.g.
  // directly in Gmail) -- only reflects actions this app took.
  inInbox        Boolean     @default(true)
  // Lazily fetched -- null/unset until something actually needs body
  // content (an AI rule prompt, e.g.). bodyFetchedAt is set even on a
  // fetch that finds no text part, so we don't keep retrying it forever.
  bodyText       String?
  bodyFetchedAt  DateTime?
  // Parsed from the List-Unsubscribe/List-Unsubscribe-Post headers (fetched
  // as part of the regular sync -- header-only fetches are cheap, unlike
  // bodies). listUnsubscribeOneClick means the sender supports RFC 8058
  // (a POST to listUnsubscribeUrl unsubscribes with no further user
  // interaction); otherwise the http(s) link/mailto address need a manual
  // click or a sent email. unsubscribeHeadersFetchedAt is set even when no
  // header is present, so backfill-unsubscribe-headers doesn't retry
  // messages that genuinely have none forever.
  listUnsubscribeUrl         String?
  listUnsubscribeMailto      String?
  listUnsubscribeOneClick    Boolean     @default(false)
  unsubscribeHeadersFetchedAt DateTime?
  createdAt      DateTime    @default(now())
  ruleMatches    RuleMatch[]

  @@unique([mailboxId, uid])
  @@index([gmailThreadId])
  @@index([fromAddress])
}

// Tracks bulk-unsubscribe status per sender address -- not derived from
// Message since "unsubscribed" is a decision this app recorded, not
// something observable from synced mail alone.
model SenderStatus {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  senderAddress String
  // "unhandled" | "unsubscribed" -- kept as a plain string (validated in
  // code) rather than a Prisma enum, so adding a status later doesn't need
  // a migration.
  status        String   @default("unhandled")
  updatedAt     DateTime @updatedAt

  @@unique([accountId, senderAddress])
}

model Rule {
  id         String      @id @default(cuid())
  accountId  String
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  enabled    Boolean     @default(true)
  // RuleCondition[] (see packages/core/src/rules/types.ts) -- ALL conditions
  // must match (AND) for v1. Stored as JSON rather than normalized rows
  // since there's no UI yet to justify the extra join complexity. At least
  // one of conditions/aiPrompt must be set (enforced in application code).
  conditions Json?
  // Natural-language condition evaluated via a local LLM (see
  // packages/core/src/ai/ollama.ts), against messages that already pass
  // `conditions` (if any) -- conditions act as a cheap pre-filter before
  // the more expensive AI call.
  aiPrompt   String?
  // RuleAction[] (see packages/core/src/rules/actions.ts) -- applied in
  // order to every match. Optional: a rule can exist purely for
  // detection/visibility with no actions yet.
  actions    Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  matches    RuleMatch[]

  @@unique([accountId, name])
}

model RuleMatch {
  id              String    @id @default(cuid())
  ruleId          String
  rule            Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  messageId       String
  message         Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  matchedAt       DateTime  @default(now())
  // Set once the rule's actions have been applied to this match over IMAP
  // -- null means "detected but not yet acted on" (or the rule has no
  // actions), letting detection and action execution run/fail
  // independently and idempotently.
  actionsAppliedAt DateTime?
  actionsError     String?

  @@unique([ruleId, messageId])
  @@index([messageId])
}
