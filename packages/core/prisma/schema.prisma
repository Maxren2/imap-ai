generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person who can sign in. Deliberately minimal -- password auth only
// (see apps/web/auth.ts), no session/OAuth-provider tables of our own:
// Auth.js runs in JWT mode here, so it needs no adapter and no schema of
// its own. One User can link any number of EmailAccounts across providers.
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  // Plain string, not a Prisma enum, matching this project's existing
  // convention for small closed sets (Rule.systemType, SenderStatus.status)
  // -- "admin" or "user". The very first person to ever sign up becomes
  // admin automatically (see apps/web/app/signup/actions.ts); every
  // signup after that defaults to "user". Admins can promote/demote other
  // users and remove accounts from /admin/users -- this is the only
  // authorization tier in the app right now, not a general role/permission
  // system.
  role          String         @default("user")
  createdAt     DateTime       @default(now())
  emailAccounts EmailAccount[]

  // Weekly availability window for calendar-aware scheduling replies (see
  // CalendarConnection below) -- a single flat window applied to every
  // listed weekday, not a full per-day schedule: simpler to configure and
  // enough to let the AI propose real free times instead of vague ones.
  // Null/empty means "not configured yet" -- draft/autoReply generation
  // still includes upcoming calendar events (busy times) if any calendars
  // are connected, just without a preferred window to suggest slots from.
  availabilityTimezone String?
  availabilityDays     String[] @default([])
  availabilityStart    String?
  availabilityEnd      String?

  calendarConnections CalendarConnection[]
}

// A read-only calendar grant used only to check availability when
// drafting scheduling replies (see packages/core/src/calendar/) -- NOT
// mail access, and deliberately separate from EmailAccount: linking a
// mailbox for IMAP/SMTP and linking a calendar for availability are
// different grants a user might want independently (e.g. a personal
// Gmail calendar while their linked mailbox is a work IMAP account).
// Reuses the same GOOGLE_CLIENT_ID/SECRET / MICROSOFT_CLIENT_ID/SECRET
// registered OAuth apps as mail linking, just with a calendar-only scope
// requested on this grant (calendar.readonly / Calendars.Read) -- see
// DESIGN.md for why full Gmail API / Graph mail access is otherwise
// avoided; this is a narrow, explicit exception for calendar data only,
// which has no IMAP equivalent.
model CalendarConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "google" | "microsoft"
  provider  String
  email     String
  // Which calendar within the provider account -- "primary" (Google) or
  // the default calendar (Microsoft) unless the user picks a different
  // one later; no UI for that yet, always "primary"/"default" for now.
  calendarId           String
  oauthRefreshTokenEnc String
  createdAt            DateTime @default(now())

  @@unique([userId, provider, email])
}

// A single linked mailbox. Named EmailAccount (not Account) to keep "a
// person who signs in" (User) and "a mailbox someone connected" clearly
// separate -- also avoids colliding with Auth.js's own Account model, even
// though this project doesn't use Auth.js's adapter/table set at all.
//
// Credential storage differs by provider: gmail/outlook use OAuth (a
// refresh token, encrypted -- see packages/core/src/crypto.ts), imap uses
// a plain username/password against a caller-supplied host (also
// encrypted). Exactly one credential shape is populated per row, chosen by
// `provider`; enforced in application code, not the schema, same as this
// project's other "tagged union stored as nullable columns" fields
// (Rule.conditions/aiPrompt, etc.).
model EmailAccount {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  // "gmail" | "outlook" | "imap" -- plain string (validated in code), same
  // reasoning as Rule.systemType/SenderStatus.status.
  provider  String
  createdAt DateTime @default(now())

  // How far back a first sync/backfill should reach for this account (30/
  // 90/0), user-configurable from /settings -- see mailbox-sync.ts's
  // resolveBackfillSince. 0 means "all" (full history), same convention
  // the old SYNC_BACKFILL_DAYS env var used. Per-account, not per-user: a
  // person can have several linked mailboxes with different needs.
  syncDepthDays Int @default(30)

  // gmail / outlook (OAuth, XOAUTH2)
  oauthRefreshTokenEnc String?

  // imap (generic provider, plain LOGIN auth)
  imapHost        String?
  imapPort        Int?
  imapUser        String?
  imapPasswordEnc String?
  smtpHost        String?
  smtpPort        Int?

  mailboxes               Mailbox[]
  rules                   Rule[]
  senderStatuses          SenderStatus[]
  coldEmailExceptions     ColdEmailException[]
  backgroundRuns          BackgroundRun[]
  chats                   Chat[]
  senderCategoryOverrides SenderCategoryOverride[]

  @@unique([userId, email])
}

// Tracks a detached background process spawned from the web UI (currently
// rules:run / rules:apply-actions) so the UI can show live status/output
// instead of "refresh the page after a bit and hope" -- the process
// previously ran with stdio fully discarded. `log` is the accumulated
// stdout+stderr text, overwritten (not appended) on each flush from the
// spawning server action -- simpler than real append-only storage for the
// modest output volume these scripts produce, and avoids any read-modify-
// write race since only the one spawning process ever writes a given row.
model BackgroundRun {
  id         String       @id @default(cuid())
  accountId  String
  account    EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // "rules:run" | "rules:apply-actions" -- a plain string (validated in
  // code), not a Prisma enum, same reasoning as SenderStatus.status.
  kind       String
  // "running" | "succeeded" | "failed" | "cancelled"
  status     String       @default("running")
  log        String       @default("")
  // The spawned child process's PID (the shell's, since spawn uses
  // shell: true -- see background-run.ts), so a "Cancel" click can find
  // and kill it later from a completely separate request. Null once the
  // run finishes; never reused across runs.
  pid        Int?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
}

model Chat {
  id        String        @id @default(cuid())
  accountId String
  account   EmailAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Null until the user renames the thread, or the first user message
  // auto-titles it (see apps/web/app/api/chat/route.ts) -- inbox-zero's real
  // chat history falls back to a date-based label in this case rather than
  // deriving one, but a content-derived title reads better in a thread list.
  name      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([accountId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant" | "system"
  // AI SDK UIMessage `parts` array (text/tool-call/tool-result parts),
  // stored as-is rather than flattened to a plain string -- that's what
  // the frontend needs back to re-render tool cards on reload.
  parts     Json
  createdAt DateTime @default(now())

  @@index([chatId])
}

model Mailbox {
  id                String       @id @default(cuid())
  accountId         String
  account           EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String
  uidValidity       BigInt
  lastSeenUid       Int          @default(0)
  // Marks the sync-window boundary from a date-bounded first sync (see
  // SYNC_BACKFILL_DAYS): everything with uid <= this value has NOT been
  // synced yet. Null once there's nothing left to backfill.
  backfillBeforeUid Int?
  fullyBackfilled   Boolean      @default(false)
  createdAt         DateTime     @default(now())
  messages          Message[]

  @@unique([accountId, name])
}

model Message {
  id                          String             @id @default(cuid())
  mailboxId                   String
  mailbox                     Mailbox            @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  uid                         Int
  gmailThreadId               String?
  gmailMessageId              String?
  // The real RFC822 Message-ID header (imapflow's envelope.messageId) --
  // distinct from gmailMessageId above, which is Gmail's own internal
  // X-GM-MSGID extension attribute, not usable for email threading.
  // Needed to set In-Reply-To/References when actually sending a reply
  // (see mail-actions.ts's replyToThread) so mail clients thread it
  // correctly. Already present in every sync's existing ENVELOPE fetch --
  // no extra IMAP round trip to capture it.
  messageIdHeader             String?
  subject                     String?
  fromAddress                 String?
  fromName                    String?
  // Only meaningfully populated for messages we sent (the IMAP envelope's
  // "to" address) -- used by the No-Reply feature to show who a sent
  // message went to, since `fromAddress` on a sent message is our own
  // address, not the recipient's. Not backfilled for existing sent mail by
  // a normal incremental sync (which only fetches UIDs newer than the last
  // seen one) -- see `npm run backfill-to-address` for that.
  toAddress                   String?
  toName                      String?
  date                        DateTime
  flags                       String[]
  labels                      String[]
  // Tracked explicitly rather than derived from `labels` -- Gmail's
  // X-GM-LABELS response omits "\Inbox" when a message is fetched from
  // within the INBOX mailbox itself (confirmed live: only present when
  // viewed from a *different* folder), so the label array can't be used
  // to tell whether a synced-from-INBOX message is still there. Defaults
  // true on sync (it came from INBOX); set false by our own archive
  // actions. Doesn't detect an archive done outside this app (e.g.
  // directly in Gmail) -- only reflects actions this app took.
  inInbox                     Boolean            @default(true)
  // Lazily fetched -- null/unset until something actually needs body
  // content (an AI rule prompt, e.g.). bodyFetchedAt is set even on a
  // fetch that finds no text part, so we don't keep retrying it forever.
  bodyText                    String?
  bodyFetchedAt               DateTime?
  // Parsed from the List-Unsubscribe/List-Unsubscribe-Post headers (fetched
  // as part of the regular sync -- header-only fetches are cheap, unlike
  // bodies). listUnsubscribeOneClick means the sender supports RFC 8058
  // (a POST to listUnsubscribeUrl unsubscribes with no further user
  // interaction); otherwise the http(s) link/mailto address need a manual
  // click or a sent email. unsubscribeHeadersFetchedAt is set even when no
  // header is present, so backfill-unsubscribe-headers doesn't retry
  // messages that genuinely have none forever.
  listUnsubscribeUrl          String?
  listUnsubscribeMailto       String?
  listUnsubscribeOneClick     Boolean            @default(false)
  unsubscribeHeadersFetchedAt DateTime?
  createdAt                   DateTime           @default(now())
  ruleMatches                 RuleMatch[]
  ruleAiEvaluations           RuleAiEvaluation[]

  @@unique([mailboxId, uid])
  @@index([gmailThreadId])
  @@index([fromAddress])
}

// Tracks bulk-unsubscribe status per sender address -- not derived from
// Message since "unsubscribed" is a decision this app recorded, not
// something observable from synced mail alone.
model SenderStatus {
  id            String       @id @default(cuid())
  accountId     String
  account       EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  senderAddress String
  // "unhandled" | "unsubscribed" -- kept as a plain string (validated in
  // code) rather than a Prisma enum, so adding a status later doesn't need
  // a migration.
  status        String       @default("unhandled")
  updatedAt     DateTime     @updatedAt

  @@unique([accountId, senderAddress])
}

// A user-set override for a sender's Analytics category (Newsletter/
// Marketing/Receipt/Notification/Other), for the hand-correction UI on
// /stats -- the heuristic in lib/analytics/categorize-sender.ts is a
// static guess and gets some senders wrong (documented known gap: non-
// English patterns), so a manual correction has to persist somewhere the
// heuristic itself can't (it's stateless, recomputed fresh every page
// load). Same small-dedicated-table pattern as SenderStatus/
// ColdEmailException above rather than a generic per-sender metadata blob.
model SenderCategoryOverride {
  id            String       @id @default(cuid())
  accountId     String
  account       EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  senderAddress String
  category      String
  updatedAt     DateTime     @updatedAt

  @@unique([accountId, senderAddress])
}

// A sender the user explicitly said is not a cold email, for the Cold
// Email Blocker feature -- inbox-zero's real version folds this into a
// generic Group/GroupItem "learned pattern" table; this project doesn't
// have that abstraction, so it's a small dedicated table instead (same
// pattern as SenderStatus above). Presence of a row is the exclusion --
// there's no "confirmed cold" counterpart yet (a RuleMatch on the
// cold-email Rule already covers that).
model ColdEmailException {
  id            String       @id @default(cuid())
  accountId     String
  account       EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  senderAddress String
  createdAt     DateTime     @default(now())

  @@unique([accountId, senderAddress])
}

model Rule {
  id                  String             @id @default(cuid())
  accountId           String
  account             EmailAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                String
  enabled             Boolean            @default(true)
  // Marks a rule as owning a built-in feature (currently just
  // "COLD_EMAIL") so that feature can find its rule reliably instead of by
  // name -- a plain string (validated in code), not a Prisma enum, for the
  // same reason SenderStatus.status is a string. Nullable + unique: a
  // Postgres unique constraint treats multiple NULLs as distinct, so
  // ordinary user-created rules (systemType left unset) never collide with
  // each other, only a second attempt at the same system type would.
  systemType          String?
  // RuleCondition[] (see packages/core/src/rules/types.ts) -- ALL conditions
  // within this array always AND together (matching inbox-zero's own real
  // model, confirmed from its source: its static from/to/subject/body
  // bundle has no OR between fields either -- only between the whole
  // static bundle and the AI prompt, see conditionalOperator below).
  // Stored as JSON rather than normalized rows since there's no UI need
  // for the extra join complexity. At least one of conditions/aiPrompt
  // must be set (enforced in application code).
  conditions          Json?
  // Natural-language condition evaluated via a local LLM (see
  // packages/core/src/ai/ollama.ts).
  aiPrompt            String?
  // How `conditions` and `aiPrompt` combine when both are set (ignored
  // when only one is set) -- "AND" (default): conditions act as a cheap
  // pre-filter, aiPrompt only runs on what already passed (the original,
  // only behavior before this field existed). "OR": a message matching
  // `conditions` matches immediately without an AI call (same short-
  // circuit inbox-zero's real OR mode uses); a message that doesn't is
  // still checked against aiPrompt, since OR means either side alone is
  // enough. Plain string, not a Prisma enum, for the same reason
  // SenderStatus.status/Rule.systemType are.
  conditionalOperator String             @default("AND")
  // RuleAction[] (see packages/core/src/rules/actions.ts) -- applied in
  // order to every match. Optional: a rule can exist purely for
  // detection/visibility with no actions yet.
  actions             Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  matches             RuleMatch[]
  aiEvaluations       RuleAiEvaluation[]

  @@unique([accountId, name])
  @@unique([accountId, systemType])
}

model RuleMatch {
  id               String    @id @default(cuid())
  ruleId           String
  rule             Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  messageId        String
  message          Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  matchedAt        DateTime  @default(now())
  // Set once the rule's actions have been applied to this match over IMAP
  // -- null means "detected but not yet acted on" (or the rule has no
  // actions), letting detection and action execution run/fail
  // independently and idempotently.
  actionsAppliedAt DateTime?
  actionsError     String?

  @@unique([ruleId, messageId])
  @@index([messageId])
}

// Marks a message as already AI-evaluated for a rule, regardless of
// whether it matched -- RuleMatch only records genuine matches, so
// without this, a message the AI said "no" to has no record of having
// been checked at all and would be re-selected as a candidate (and
// re-sent to the AI) on every future rules:run, forever, at the expense
// of ever reaching older/different candidates once a rule's per-run AI
// cap (RULES_AI_MAX_PER_RUN) is smaller than its backlog -- a real bug
// found while running Cold Email Blocker's detection against ~11,000
// real candidates for the first time. run.ts's candidate query excludes
// messages with either a RuleMatch or a row here.
model RuleAiEvaluation {
  id          String   @id @default(cuid())
  ruleId      String
  rule        Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  evaluatedAt DateTime @default(now())

  @@unique([ruleId, messageId])
  @@index([messageId])
}
