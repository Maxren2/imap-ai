generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String    @id @default(cuid())
  email     String    @unique
  provider  String
  createdAt DateTime  @default(now())
  mailboxes Mailbox[]
  rules     Rule[]
}

model Mailbox {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  uidValidity BigInt
  lastSeenUid Int       @default(0)
  // Marks the sync-window boundary from a date-bounded first sync (see
  // SYNC_BACKFILL_DAYS): everything with uid <= this value has NOT been
  // synced yet. Null once there's nothing left to backfill.
  backfillBeforeUid Int?
  fullyBackfilled   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  messages    Message[]

  @@unique([accountId, name])
}

model Message {
  id             String      @id @default(cuid())
  mailboxId      String
  mailbox        Mailbox     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  uid            Int
  gmailThreadId  String?
  gmailMessageId String?
  subject        String?
  fromAddress    String?
  fromName       String?
  date           DateTime
  flags          String[]
  labels         String[]
  // Lazily fetched -- null/unset until something actually needs body
  // content (an AI rule prompt, e.g.). bodyFetchedAt is set even on a
  // fetch that finds no text part, so we don't keep retrying it forever.
  bodyText       String?
  bodyFetchedAt  DateTime?
  createdAt      DateTime    @default(now())
  ruleMatches    RuleMatch[]

  @@unique([mailboxId, uid])
  @@index([gmailThreadId])
}

model Rule {
  id         String      @id @default(cuid())
  accountId  String
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  enabled    Boolean     @default(true)
  // RuleCondition[] (see packages/core/src/rules/types.ts) -- ALL conditions
  // must match (AND) for v1. Stored as JSON rather than normalized rows
  // since there's no UI yet to justify the extra join complexity. At least
  // one of conditions/aiPrompt must be set (enforced in application code).
  conditions Json?
  // Natural-language condition evaluated via a local LLM (see
  // packages/core/src/ai/ollama.ts), against messages that already pass
  // `conditions` (if any) -- conditions act as a cheap pre-filter before
  // the more expensive AI call.
  aiPrompt   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  matches    RuleMatch[]

  @@unique([accountId, name])
}

model RuleMatch {
  id        String   @id @default(cuid())
  ruleId    String
  rule      Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  matchedAt DateTime @default(now())

  @@unique([ruleId, messageId])
  @@index([messageId])
}
