# Gmail account being accessed over IMAP.
GMAIL_ADDRESS=you@gmail.com

# OAuth2 client from a Google Cloud project with the Gmail API's IMAP/SMTP
# scope enabled (same kind of project inbox-zero uses). Client type: Desktop
# app or Web app both work as long as the redirect URI used to mint the
# refresh token matches.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token minted with scope https://mail.google.com/ (full IMAP/SMTP
# access -- the narrower gmail.readonly/gmail.modify scopes do NOT work for
# IMAP). See README "Getting Started" for how to obtain one.
GOOGLE_REFRESH_TOKEN=
