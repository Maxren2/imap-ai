# --- Auth (apps/web) ---

# Signs Auth.js's session JWTs. Generate once with `openssl rand -base64 32`
# -- never auto-generated by the app itself (see the "no auto-generated
# secrets" convention this project follows for every secret below too).
AUTH_SECRET=

# Encrypts every linked account's OAuth refresh token / IMAP password
# before it's written to the database. Generate once with
# `openssl rand -base64 32` and never change it once real accounts are
# linked -- rotating it would make every stored credential undecryptable.
CREDENTIAL_ENCRYPTION_KEY=

# --- Gmail (one OAuth app, shared by every user who links a Gmail account) ---

# OAuth2 client from a Google Cloud project with the Gmail API's IMAP/SMTP
# scope enabled (same kind of project inbox-zero uses). Redirect URI:
# <origin>/api/connect/google/callback -- add it in Google Cloud Console's
# OAuth client settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook (one Azure AD app, shared by every user who links Outlook) ---

# App registration in Azure AD/Entra ID with the delegated
# https://outlook.office.com/IMAP.AccessAsUser.All + offline_access API
# permissions. Redirect URI: <origin>/api/connect/microsoft/callback.
# MICROSOFT_TENANT is "common" for personal + work/school accounts unless
# you've restricted the app registration to a specific tenant.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Legacy single-account env vars ---
#
# No longer read at runtime -- every mailbox now lives in the database,
# linked per-user through the app's own "Connect Gmail"/"Add IMAP account"
# flows. These three are used ONLY by `npm run migrate-legacy-account`, a
# one-time script for anyone upgrading from before multi-user support
# existed: it creates your first User account and imports this refresh
# token into encrypted storage, so already-synced mail isn't lost. Safe to
# delete after running it once.
GMAIL_ADDRESS=you@gmail.com
GOOGLE_REFRESH_TOKEN=

# Local Postgres mirror (see docker-compose.yml for a ready-to-run instance).
DATABASE_URL=postgresql://imap_ai:imap_ai@localhost:5432/imap_ai

# How far back a mailbox's *first* sync reaches. "all" (or "0") fetches full
# history; unset or invalid falls back to 30 days; any other positive number
# is a custom day count. Only affects the first sync -- afterwards, ongoing
# sync/watch always pick up new mail regardless of this setting. Run
# `npm run backfill` any time to fetch everything a bounded first sync left
# behind.
SYNC_BACKFILL_DAYS=30

# Local Ollama server for AI-based rule matching (OpenAI-style /api/chat
# endpoint). Rules with an aiPrompt are skipped (with a warning) if unset.
# For "thinking" models (e.g. qwen3), rules:run deliberately leaves thinking
# enabled rather than disabling it for speed -- disabling it measurably hurt
# classification accuracy on messy real-world mail in testing. Budget ~15-30s
# per AI-evaluated candidate accordingly (fine for a background rules:run,
# not for anything synchronous/interactive).
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Caps AI evaluations per rule per run (default 200 if unset). A new AI rule
# with a large backlog (e.g. right after a big sync/backfill) needs several
# rules:run passes to work through it -- each pass advances to new
# candidates rather than re-checking the same ones (RuleAiEvaluation tracks
# what's already been checked, matched or not). Lower this if each pass is
# taking too long; raise it to churn through a big backlog faster.
RULES_AI_MAX_PER_RUN=200

# Caps how many draft/autoReply/autoForward actions one rule can execute per
# rules:apply-actions run (default 20 if unset). autoReply/autoForward send
# real email immediately with no human review; draft doesn't send but still
# costs an AI call and writes a real Drafts entry -- this bounds the blast
# radius if a rule suddenly matches a large backlog (e.g. right after being
# enabled), rather than letting one run fire hundreds of real sends at
# once. The rest of a capped rule's pending matches are simply picked up on
# a later run.
RULES_AUTO_SEND_MAX_PER_RUN=20
